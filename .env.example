# Copiez ce fichier en `.env` (local) et renseignez les valeurs de votre projet Firebase :
# Console Firebase → Paramètres du projet → Vos applications → Configuration du SDK.
#
# ⚠️ Sur Vercel, ces variables doivent être ajoutées dans
#    Project → Settings → Environment Variables (Production + Preview),
#    puis le site doit être REDÉPLOYÉ : Create React App les inline au moment du build.

# Obligatoires
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=votre-projet
REACT_APP_FIREBASE_APP_ID=

# Optionnelles
REACT_APP_FIREBASE_STORAGE_BUCKET=votre-projet.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# UID Firebase du compte administrateur Elysium (accès /admin, badge "Officiel")
REACT_APP_ADMIN_UID=
