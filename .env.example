# Copiez ce fichier en `.env` (local) et renseignez les valeurs de votre projet Firebase :
# Console Firebase → Paramètres du projet → Vos applications → Configuration du SDK.
#
# ⚠️ Sur Vercel, ces variables doivent être ajoutées dans
#    Project → Settings → Environment Variables (Production + Preview),
#    puis le site doit être REDÉPLOYÉ : les valeurs sont inlinées au moment du build.
#
# Ces noms (sans préfixe REACT_APP_) sont exposés au client via la liste
# CLIENT_ENV_VARS de craco.config.js — ajoutez-y toute nouvelle variable.

# Obligatoires
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
FIREBASE_PROJECT_ID=votre-projet
FIREBASE_APP_ID=

# Optionnelles
FIREBASE_STORAGE_BUCKET=votre-projet.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_MEASUREMENT_ID=

# UID Firebase du compte administrateur Elysium (accès /admin, badge "Officiel")
ADMIN_UID=
