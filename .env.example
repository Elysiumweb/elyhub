# Copiez ce fichier en `.env` (local) et renseignez les valeurs de votre projet Firebase :
# Console Firebase → Paramètres du projet → Vos applications → Configuration du SDK.
#
# ⚠️ Sur Vercel, ces variables doivent être ajoutées dans
#    Project → Settings → Environment Variables (Production + Preview),
#    puis le site doit être REDÉPLOYÉ : les valeurs sont inlinées au moment du build.
#
# Ces noms (sans préfixe REACT_APP_) sont exposés au client via la liste
# CLIENT_ENV_VARS de craco.config.js — ajoutez-y toute nouvelle variable.
# La forme préfixée (REACT_APP_FIREBASE_API_KEY…) est également acceptée :
# src/lib/firebase.js lit les deux et garde la valeur préfixée en priorité.

# ── Obligatoires ──────────────────────────────────────────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
FIREBASE_PROJECT_ID=votre-projet
FIREBASE_APP_ID=

# ── Optionnelles ──────────────────────────────────────────────────────────────
FIREBASE_STORAGE_BUCKET=votre-projet.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_MEASUREMENT_ID=

# ── Produit ───────────────────────────────────────────────────────────────────
# URL publique du site (canonical, sitemap, images Open Graph). Ex. https://elyhub.vercel.app
SITE_URL=

# UID Firebase du compte administrateur Elysium — BOOTSTRAP UNIQUEMENT : crée le
# premier admin. L'autorisation réelle repose ensuite sur le champ `role` des
# documents users/{uid} (admin | moderator), contrôlé par firestore.rules.
ADMIN_UID=

# ── Connexions sociales (Firebase Auth : activer les fournisseurs correspondants) ──
# Discord : OIDC Discord (client_id requis)
DISCORD_CLIENT_ID=
# Steam : OIDC Steam (api_key requis)
STEAM_API_KEY=
# Twitch : fournisseur twitch.com (client_id requis)
TWITCH_CLIENT_ID=

# ── Recherche serveur (Meilisearch, optionnel) ────────────────────────────────
# Sans ces variables, la recherche reste locale (filtres côté client).
SEARCH_HOST=
SEARCH_KEY=
