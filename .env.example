# Configuration Firebase d'ElyHub.
#
# DEUX NOMENCLATURES ACCEPTÉES (la version préfixée est prioritaire) :
#   FIREBASE_API_KEY=...            (recommandé — exposé au client via CLIENT_ENV_VARS dans craco.config.js)
#   REACT_APP_FIREBASE_API_KEY=...  (standard Create React App)
#
# En local : copiez ce fichier en `.env` et renseignez vos valeurs
# (console Firebase → Paramètres du projet → Vos applications → Configuration du SDK).
#
# ⚠️ Sur Vercel : ajoutez ces variables dans Project → Settings → Environment
# Variables (Production + Preview) puis REDÉPLOYEZ — les valeurs sont
# injectées dans le JS au moment du build. Sans elles, le site affiche
# un écran "Firebase n'est pas configuré" au lieu de l'application.
# Pensez aussi à ajouter votre domaine Vercel dans
# Firebase → Authentication → Settings → Authorized domains.

# Obligatoires
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
FIREBASE_PROJECT_ID=votre-projet
FIREBASE_APP_ID=

# Optionnelles
FIREBASE_STORAGE_BUCKET=votre-projet.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_MEASUREMENT_ID=

# UID Firebase du compte administrateur Elysium (accès /admin, badge "Officiel")
# (ou REACT_APP_ADMIN_UID)
ADMIN_UID=
